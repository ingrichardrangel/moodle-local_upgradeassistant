<section class="ua-stage ua-reports-page" aria-labelledby="ua-reports-title" data-review-saved="{{#str}} findingreviewed, local_upgradeassistant {{/str}}" data-review-error="{{#str}} findingreviewerror, local_upgradeassistant {{/str}}" data-review-saved-refresh="{{#str}} findingreviewsavedrefresh, local_upgradeassistant {{/str}}">
    <div class="ua-stage-header">
        <div><span class="ua-eyebrow">{{#str}} evidenceandtraceability, local_upgradeassistant {{/str}}</span><h3 id="ua-reports-title">{{#str}} reportspageheading, local_upgradeassistant {{/str}}</h3><p>{{#str}} reportspageintro, local_upgradeassistant {{/str}}</p></div>
    </div>
    <div class="ua-review-feedback alert" role="status" aria-live="polite"></div>

    {{^proreport.available}}
    <div class="ua-empty-state"><i class="fa fa-file-o" aria-hidden="true"></i><h4>{{#str}} noreportyet, local_upgradeassistant {{/str}}</h4><p>{{#str}} noreportyetdesc, local_upgradeassistant {{/str}}</p><a class="btn btn-primary" href="{{wizardurl}}">{{#str}} returntoassistant, local_upgradeassistant {{/str}}</a></div>
    {{/proreport.available}}

    {{#proreport.available}}
    <div class="ua-report-heading">
        <div class="ua-risk-score {{proreport.riskclass}}"><span>{{#str}} risklevel, local_upgradeassistant {{/str}}</span><strong>{{proreport.riskscore}}/100</strong><small>{{proreport.risklevel}}</small></div>
        <div><span>{{#str}} preparationreport, local_upgradeassistant {{/str}} #{{proreport.id}}</span><h4>{{proreport.currentrelease}} <i class="fa fa-long-arrow-right" aria-hidden="true"></i> {{proreport.targetrelease}}</h4><p>{{#str}} generatedon, local_upgradeassistant {{/str}} {{proreport.timecreated}} · {{proreport.generatedby}}</p></div>
        {{#capabilities.canexport}}
        <details class="ua-export-menu">
            <summary class="btn btn-primary"><i class="fa fa-download" aria-hidden="true"></i> {{#str}} exportmenu, local_upgradeassistant {{/str}}</summary>
            <div>
                {{#capabilities.canexportcomplete}}
                <form method="post" action="{{exporturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="reportid" value="{{proreport.id}}"><input type="hidden" name="type" value="pdf"><input type="hidden" name="redacted" value="0"><button type="submit"><i class="fa fa-file-pdf-o" aria-hidden="true"></i> {{#str}} pdfcomplete, local_upgradeassistant {{/str}}</button></form>
                <form method="post" action="{{exporturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="reportid" value="{{proreport.id}}"><input type="hidden" name="type" value="html"><input type="hidden" name="redacted" value="0"><button type="submit"><i class="fa fa-file-code-o" aria-hidden="true"></i> {{#str}} htmlcomplete, local_upgradeassistant {{/str}}</button></form>
                {{/capabilities.canexportcomplete}}
                {{#capabilities.canexportredacted}}
                <form method="post" action="{{exporturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="reportid" value="{{proreport.id}}"><input type="hidden" name="type" value="pdf"><input type="hidden" name="redacted" value="1"><button type="submit"><i class="fa fa-eye-slash" aria-hidden="true"></i> {{#str}} pdfredacted, local_upgradeassistant {{/str}}</button></form>
                <form method="post" action="{{exporturl}}"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="reportid" value="{{proreport.id}}"><input type="hidden" name="type" value="html"><input type="hidden" name="redacted" value="1"><button type="submit"><i class="fa fa-eye-slash" aria-hidden="true"></i> {{#str}} htmlredacted, local_upgradeassistant {{/str}}</button></form>
                {{/capabilities.canexportredacted}}
            </div>
        </details>
        {{/capabilities.canexport}}
    </div>

    <details class="ua-details">
        <summary><i class="fa fa-exclamation-circle" aria-hidden="true"></i> {{#str}} reportfindings, local_upgradeassistant {{/str}}</summary>
        <div class="ua-details-body">
            {{#proreport.hasitems}}
            <div class="ua-findings">
                {{#proreport.items}}
                <article data-ua-finding-id="{{id}}">
                    <div>
                        <span class="ua-badge {{severityclass}}">{{severity}}</span>
                        <span class="ua-badge {{statusclass}}">{{status}}</span>
                    </div>
                    <h4>{{title}}</h4>
                    <p>{{description}}</p>
                    <small><strong>{{#str}} recommendation, local_upgradeassistant {{/str}}:</strong> {{recommendation}}</small>

                    {{#hasreviewnote}}
                    <div class="ua-review-evidence">
                        <i class="fa fa-user" aria-hidden="true"></i>
                        <div>
                            <strong>{{#str}} administratorcriterion, local_upgradeassistant {{/str}}</strong>
                            <p>{{reviewnote}}</p>
                            <small>{{reviewedby}}{{#reviewedat}} · {{reviewedat}}{{/reviewedat}}</small>
                        </div>
                    </div>
                    {{/hasreviewnote}}

                    {{#canreview}}
                    {{#capabilities.canmanage}}
                    <form method="post" action="{{actionurl}}" class="ua-finding-review-form">
                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                        <input type="hidden" name="action" value="reviewfinding">
                        <input type="hidden" name="findingid" value="{{id}}">
                        <input type="hidden" name="reportid" value="{{reportid}}">
                        <input type="hidden" name="returnview" value="reports">
                        <label for="findingnote-{{id}}">{{#str}} administratorcriterionlabel, local_upgradeassistant {{/str}}</label>
                        <textarea id="findingnote-{{id}}" name="auditnote" class="form-control" rows="3" maxlength="2000" required placeholder="{{#str}} administratorcriterionplaceholder, local_upgradeassistant {{/str}}"></textarea>
                        <div class="ua-review-actions">
                            <small><i class="fa fa-info-circle" aria-hidden="true"></i> {{#str}} administratorcriterionhelp, local_upgradeassistant {{/str}}</small>
                            <button type="submit" class="btn btn-outline-success">
                                <i class="fa fa-check-circle" aria-hidden="true"></i>
                                {{#str}} markasreviewed, local_upgradeassistant {{/str}}
                            </button>
                        </div>
                        <div class="ua-review-inline-status" role="status" aria-live="polite"></div>
                    </form>
                    {{/capabilities.canmanage}}
                    {{/canreview}}
                </article>
                {{/proreport.items}}
            </div>
            {{/proreport.hasitems}}
        </div>
    </details>

    {{#proreport.lifecycle.available}}
    <details class="ua-details"><summary><i class="fa fa-life-ring" aria-hidden="true"></i> {{#str}} lifecyclepdfsectiontitle, local_upgradeassistant {{/str}}</summary><div class="ua-details-body"><div class="ua-lifecycle-summary"><article><span>{{#str}} current, local_upgradeassistant {{/str}}</span><strong>{{proreport.lifecycle.current.label}}</strong><span class="ua-badge {{proreport.lifecycle.current.statusclass}}">{{proreport.lifecycle.current.statuslabel}}</span></article>{{#proreport.lifecycle.hastarget}}<article><span>{{#str}} targetversion, local_upgradeassistant {{/str}}</span><strong>{{proreport.lifecycle.target.label}}</strong><span class="ua-badge {{proreport.lifecycle.target.statusclass}}">{{proreport.lifecycle.target.statuslabel}}</span></article>{{/proreport.lifecycle.hastarget}}<article><span>{{#str}} recommendation, local_upgradeassistant {{/str}}</span><small>{{proreport.lifecycle.recommendation}}</small></article></div></div></details>
    {{/proreport.lifecycle.available}}

    {{#proreport.haspluginrows}}
    <details class="ua-details"><summary><i class="fa fa-puzzle-piece" aria-hidden="true"></i> {{#str}} advancedpluginmatrix, local_upgradeassistant {{/str}}</summary><div class="ua-details-body"><div class="ua-tablewrap"><table class="generaltable table"><thead><tr><th>{{#str}} component, local_upgradeassistant {{/str}}</th><th>{{#str}} currentversion, local_upgradeassistant {{/str}}</th><th>{{#str}} targetversion, local_upgradeassistant {{/str}}</th><th>{{#str}} status, local_upgradeassistant {{/str}}</th></tr></thead><tbody>{{#proreport.pluginrows}}<tr><td>{{component}}</td><td>{{version}}</td><td>{{targetversion}}</td><td><span class="ua-badge {{statusclass}}">{{status}}</span></td></tr>{{/proreport.pluginrows}}</tbody></table></div></div></details>
    {{/proreport.haspluginrows}}

    <details class="ua-details"><summary><i class="fa fa-check-square-o" aria-hidden="true"></i> {{#str}} auditablechecklist, local_upgradeassistant {{/str}}</summary><div class="ua-details-body ua-audit-list">
        {{#proreport.checklist}}
        <article class="ua-audititem {{#completed}}is-complete{{/completed}}"><div><h4>{{title}} <span class="ua-badge {{statusclass}}">{{status}}</span></h4><p>{{description}}</p>{{#completed}}<small>{{completedby}} · {{completedat}}{{#note}} · {{note}}{{/note}}</small>{{/completed}}</div>{{^completed}}{{#capabilities.canmanage}}<form method="post" action="{{actionurl}}" class="ua-audit-form"><input type="hidden" name="sesskey" value="{{sesskey}}"><input type="hidden" name="action" value="completeauditstep"><input type="hidden" name="checklistid" value="{{id}}"><input type="hidden" name="reportid" value="{{reportid}}"><input type="hidden" name="returnview" value="reports"><label class="sr-only visually-hidden" for="auditnote-{{id}}">{{#str}} auditnoteplaceholder, local_upgradeassistant {{/str}}</label><input id="auditnote-{{id}}" type="text" name="auditnote" class="form-control" placeholder="{{#str}} auditnoteplaceholder, local_upgradeassistant {{/str}}"><button type="submit" class="btn btn-outline-success">{{#str}} markcomplete, local_upgradeassistant {{/str}}</button></form>{{/capabilities.canmanage}}{{/completed}}</article>
        {{/proreport.checklist}}
    </div></details>
    {{/proreport.available}}

    <section class="ua-history" aria-labelledby="ua-history-title">
        <div class="ua-section-title"><div><h4 id="ua-history-title">{{#str}} reporthistorytitle, local_upgradeassistant {{/str}}</h4><p>{{#str}} reporthistorydescnew, local_upgradeassistant {{/str}}</p></div></div>
        {{^reporthistory.hasrows}}<p class="ua-muted">{{#str}} nohistoryreports, local_upgradeassistant {{/str}}</p>{{/reporthistory.hasrows}}
        {{#reporthistory.hasrows}}<div class="ua-tablewrap"><table class="generaltable table"><thead><tr><th>ID</th><th>{{#str}} date, local_upgradeassistant {{/str}}</th><th>{{#str}} route, local_upgradeassistant {{/str}}</th><th>{{#str}} risklevel, local_upgradeassistant {{/str}}</th><th>{{#str}} action, local_upgradeassistant {{/str}}</th></tr></thead><tbody>
            {{#reporthistory.rows}}<tr><td>#{{id}}</td><td>{{timecreated}}</td><td>{{currentrelease}} → {{targetrelease}}</td><td><span class="ua-badge {{riskclass}}">{{riskscore}}/100 · {{risklevel}}</span></td><td><a href="{{viewurl}}">{{#str}} viewdetails, local_upgradeassistant {{/str}}</a></td></tr>{{/reporthistory.rows}}
        </tbody></table></div>{{/reporthistory.hasrows}}
    </section>
</section>
