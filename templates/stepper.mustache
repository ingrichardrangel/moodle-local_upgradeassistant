<nav class="ua-stepper" aria-label="{{#str}} wizardsteps, local_upgradeassistant {{/str}}">
    {{#dashboard.steps}}
        {{#available}}
        <a href="{{url}}" class="ua-step {{#active}}is-active{{/active}} {{#complete}}is-complete{{/complete}}" {{#active}}aria-current="step"{{/active}}>
            <span class="ua-step-number">
                {{#complete}}<i class="fa fa-check" aria-hidden="true"></i>{{/complete}}
                {{^complete}}{{number}}{{/complete}}
            </span>
            <span><i class="fa {{icon}}" aria-hidden="true"></i> {{label}}</span>
        </a>
        {{/available}}
        {{^available}}
        <span class="ua-step is-disabled" aria-disabled="true">
            <span class="ua-step-number">{{number}}</span>
            <span><i class="fa {{icon}}" aria-hidden="true"></i> {{label}}</span>
        </span>
        {{/available}}
    {{/dashboard.steps}}
</nav>
